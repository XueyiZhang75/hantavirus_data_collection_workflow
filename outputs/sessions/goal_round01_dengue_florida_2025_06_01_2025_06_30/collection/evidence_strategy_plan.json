  "source_discovery_objectives": [
    {
      "objective_id": "obj_collection_001",
      "objective": "Identify Florida Department of Health (FDOH) arbovirus surveillance reports, weekly or monthly situation reports, and press releases reporting dengue human cases, deaths, and hospitalizations in Florida during June 2025.",
      "source_role_hint": "collection",
      "rationale": "FDOH is the primary official source for dengue case counts in Florida, publishing arbovirus surveillance summaries that include travel-associated and locally acquired dengue cases by county.",
      "priority": 1
    },
    {
      "objective_id": "obj_collection_002",
      "objective": "Identify CDC ArboNET or CDC Division of Vector-Borne Diseases (DVBD) reports, tables, or dashboards containing dengue case data for Florida for June 2025.",
      "source_role_hint": "collection",
      "rationale": "CDC ArboNET is the national arboviral surveillance system and may contain Florida-specific dengue case counts, including confirmed and probable classifications.",
      "priority": 1
    },
    {
      "objective_id": "obj_collection_003",
      "objective": "Identify county-level health department reports (Miami-Dade, Broward, Palm Beach, Hillsborough, Orange) with dengue case data for June 2025.",
      "source_role_hint": "collection",
      "rationale": "High-population Florida counties with international travel hubs are most likely to report dengue cases; county health departments may publish local arbovirus alerts or situation reports.",
      "priority": 2
    },
    {
      "objective_id": "obj_validation_001",
      "objective": "Identify PAHO or WHO situation reports, disease outbreak news, or regional surveillance bulletins referencing dengue in Florida or the USA for June 2025.",
      "source_role_hint": "validation",
      "rationale": "International organization reports provide independent validation of case counts and can confirm whether Florida-specific data is included in broader US or Americas summaries.",
      "priority": 2
    },
    {
      "objective_id": "obj_validation_002",
      "objective": "Identify structured databases (HealthMap, ProMED, Global Health Monitor, or open data portals) with dengue event records for Florida in June 2025.",
      "source_role_hint": "validation",
      "rationale": "Structured surveillance databases aggregate official and news signals and can serve as independent validation against FDOH and CDC primary sources.",
      "priority": 3
    },
    {
      "objective_id": "obj_context_001",
      "objective": "Identify peer-reviewed literature or CDC case definitions establishing dengue confirmed, probable, and suspected classification criteria applicable to Florida surveillance.",
      "source_role_hint": "context",
      "rationale": "Case definition context is required to correctly interpret and normalize case classification fields (confirmed vs. probable vs. suspected) extracted from FDOH and CDC sources.",
      "priority": 4
    },
    {
      "objective_id": "obj_context_002",
      "objective": "Identify background sources describing Florida's dengue epidemiology, including travel-associated vs. locally acquired case patterns, to contextualize June 2025 data.",
      "source_role_hint": "context",
      "rationale": "Florida dengue cases are predominantly travel-associated; understanding this baseline helps flag anomalies such as locally acquired clusters or outbreaks.",
      "priority": 4
    },
    {
      "objective_id": "obj_review_001",
      "objective": "Flag any sources where dengue counts are aggregated with other arboviruses (West Nile, Zika, chikungunya) without dengue-specific breakdowns, or where reporting period substantially exceeds June 2025.",
      "source_role_hint": "human_review",
      "rationale": "Arbovirus aggregate counts without dengue-specific figures must not be extracted as dengue records; sources with broad reporting periods require human judgment on date-window fit.",
      "priority": 3
    },
    {
      "objective_id": "obj_review_002",
      "objective": "Flag any news or situation report sources that cite case counts without traceable official provenance for human review before extraction.",
      "source_role_hint": "human_review",
      "rationale": "News sources may cite unofficial or unverified figures; human review ensures only traceable, provenance-backed counts enter the collection pipeline.",
      "priority": 4
    }
  ],
