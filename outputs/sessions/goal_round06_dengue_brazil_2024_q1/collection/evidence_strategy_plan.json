  "source_discovery_objectives": [
    {
      "objective_id": "obj_collection_001",
      "objective": "Identify Brazilian Ministry of Health (SVS/MS) epidemiological bulletins and situation reports for Dengue covering 2024-01-01 to 2024-03-31, with subnational case, death, and hospitalization counts.",
      "source_role_hint": "collection",
      "rationale": "SVS (Secretaria de Vigilância em Saúde) publishes weekly and periodic boletins epidemiológicos with state-level and national dengue counts. These are the primary authoritative collection sources for Brazil.",
      "priority": 1
    },
    {
      "objective_id": "obj_collection_002",
      "objective": "Identify state-level health secretariat (SES) and municipal health secretariat (SMS) reports for Dengue in Brazilian states with high outbreak burden (e.g., São Paulo, Minas Gerais, Rio de Janeiro, Paraná, Goiás) during Q1 2024.",
      "source_role_hint": "collection",
      "rationale": "Subnational SES and SMS sources provide locality-level granularity not always available in national bulletins. Brazil's 2024 dengue outbreak was particularly severe in several states.",
      "priority": 1
    },
    {
      "objective_id": "obj_collection_003",
      "objective": "Identify the Painel de Arboviroses (Brasil.io or DATASUS/SVS dashboard) structured data exports for dengue cases and deaths by state and epidemiological week during SE 01–SE 13 of 2024.",
      "source_role_hint": "collection",
      "rationale": "The Painel de Arboviroses and SINAN dengue datasets provide machine-readable subnational surveillance data aligned to the task time window.",
      "priority": 1
    },
    {
      "objective_id": "obj_validation_001",
      "objective": "Identify PAHO/OPAS situation reports and epidemiological alerts for Dengue in Brazil covering Q1 2024 for independent cross-validation of national and subnational counts.",
      "source_role_hint": "validation",
      "rationale": "PAHO publishes regional dengue situation reports that include Brazil-specific data, providing an independent validation layer against SVS figures.",
      "priority": 2
    },
    {
      "objective_id": "obj_validation_002",
      "objective": "Identify WHO Disease Outbreak News (DON) or Global Health Observatory entries for Brazil Dengue 2024 as a secondary validation source.",
      "source_role_hint": "validation",
      "rationale": "WHO DON entries for Brazil dengue 2024 may contain independently reported aggregate counts usable for validation without leaking into collection.",
      "priority": 2
    },
    {
      "objective_id": "obj_validation_003",
      "objective": "Identify ProMED or HealthMap alerts for Brazil Dengue Q1 2024 as supplementary validation signals.",
      "source_role_hint": "validation",
      "rationale": "ProMED archives provide timestamped outbreak alerts with cited official figures, useful for cross-checking collection records.",
      "priority": 3
    },
    {
      "objective_id": "obj_context_001",
      "objective": "Identify Brazilian dengue case definition documents (SVS/MS) and SINAN coding guidelines to clarify distinctions between dengue sem sinais de alarme, dengue com sinais de alarme, dengue grave, and confirmed vs. probable vs. suspected classifications.",
      "source_role_hint": "context",
      "rationale": "Brazil uses a specific clinical classification system for dengue. Understanding case definitions is essential for correct field mapping of cases_confirmed, cases_probable, cases_suspected.",
      "priority": 3
    },
    {
      "objective_id": "obj_context_002",
      "objective": "Identify peer-reviewed literature or preprints describing the 2024 Brazil dengue outbreak epidemiology, including serotype distribution (DENV-1/2/3/4), to contextualize count semantics and geographic spread.",
      "source_role_hint": "context",
      "rationale": "Literature sources help interpret surveillance data, validate case definitions, and provide epidemiological context for the Q1 2024 outbreak.",
      "priority": 4
    },
    {
      "objective_id": "obj_collection_support_001",
      "objective": "Identify reputable Brazilian news sources (e.g., G1/Globo, Agência Brasil, Folha de S.Paulo) and international news reports covering dengue case and death counts in Brazil during Q1 2024, particularly for states or municipalities not covered by official bulletins.",
      "source_role_hint": "collection_support",
      "rationale": "News reports may contain early outbreak signals or subnational figures citing official sources, filling gaps in official bulletin coverage.",
      "priority": 5
    },
    {
      "objective_id": "obj_review_001",
      "objective": "Flag sources where count semantics are ambiguous (cumulative vs. weekly, confirmed vs. suspected aggregate), where validation and collection roles may overlap, or where subnational scope is unclear.",
      "source_role_hint": "human_review",
      "rationale": "Brazil's dengue reporting mixes cumulative annual totals, weekly increments, and epidemiological week aggregates. Ambiguous sources must be reviewed before extraction.",
      "priority": 2
    }
