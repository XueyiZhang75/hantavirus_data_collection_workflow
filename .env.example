OPENAI_API_KEY=
MODEL_PROVIDER=openai
DEFAULT_MODEL=gpt-4o-mini

# Optional LangSmith / LangGraph Studio tracing. The current workflow is
# offline and deterministic — no API keys are required to run it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGCHAIN_API_KEY=

# Step 5 content fetching. The workflow is offline-safe by default; tests
# must never depend on internet access. Set HDC_ENABLE_LIVE_FETCH=true only
# when manually exercising scripts/run_live_fetch_demo.py.
HDC_ENABLE_LIVE_FETCH=false
HDC_FETCH_TIMEOUT_SECONDS=15

# Stage 7 controlled fetch/parse generalization.
# Search-derived result pages are NOT fetched by default. Enable only for
# bounded smoke runs after source search and source credibility have produced
# source candidates with final roles and scores.
HDC_FETCH_SEARCH_DERIVED_SOURCES=false
HDC_FETCH_MAX_SEARCH_DERIVED_SOURCES=2
HDC_FETCH_MAX_TOTAL_SOURCES=10
HDC_FETCH_MIN_CREDIBILITY_SCORE=0.55
HDC_FETCH_ALLOWED_FINAL_ROLES=collection,collection_support,context
HDC_FETCH_ALLOW_NEEDS_REVIEW=false
HDC_FETCH_DOMAIN_ALLOWLIST=
HDC_FETCH_DOMAIN_BLOCKLIST=
HDC_FETCH_MAX_BYTES=1000000
HDC_FETCH_USER_AGENT=data-collection-workflow/0.1
HDC_FETCH_PARSE_PDF_TEXT=true
HDC_FETCH_PARSE_TABLES=true
HDC_FETCH_STORE_RAW_TEXT=false
HDC_CONTENT_FIXTURE_MAP_PATH=

# Stage 5 controlled source search. Default remains disabled.
# Search providers return result metadata only; they do not fetch page bodies.
HDC_ENABLE_LIVE_SEARCH=false
HDC_SEARCH_MODE=disabled
HDC_SEARCH_PROVIDER=tavily
HDC_SEARCH_FIXTURE_PATH=src/hdc_workflow/resources/search_fixtures/example_search_results.json
HDC_SEARCH_MAX_QUERIES=3
HDC_SEARCH_MAX_RESULTS_PER_QUERY=5
HDC_SEARCH_MAX_TOTAL_RESULTS=15
HDC_SEARCH_TIMEOUT_SECONDS=15
HDC_SEARCH_COMBINE_WITH_SEED_CATALOG=true
HDC_SEARCH_CACHE_ENABLED=true
HDC_SEARCH_PROVIDER_CHANNEL_ALLOWLIST=web_search,official_site_search,news_search,literature_api,database_search

# Optional live search provider keys. Leave blank unless manually running
# live source-search smoke tests. Never commit real keys.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SERPAPI_API_KEY=
BING_SEARCH_V7_SUBSCRIPTION_KEY=

# Step 11 local synthetic fixture mode.
# HDC_USE_FIXTURE_DOCUMENTS=true enables synthetic local fixture documents
# for deterministic end-to-end testing without internet or LLMs.
# Fixture data are NOT real public health data.
HDC_USE_FIXTURE_DOCUMENTS=false

# Task-compatible validation guardrail.
# Keep false for normal runs. Set true only for diagnostic experiments that
# intentionally force-load an incompatible explicit held-out validation CSV.
HDC_ALLOW_INCOMPATIBLE_VALIDATION_RECORDS=false

# Direct First collection controls. Interactive and visual user runs default to
# HDC_COLLECTION_MODE=direct_collection through their generated config. In this
# mode, official must-fetch documents receive protected extraction budget before
# context or validation sources.
HDC_COLLECTION_MODE=
HDC_LLM_MUST_FETCH_MIN_CHUNKS_PER_SOURCE=6
HDC_LLM_OFFICIAL_EXTRACTION_MAX_CHUNKS=30
HDC_DIRECT_COLLECTION_ENABLE_AUDIT_VALIDATION=false

# Step 14 optional LLM-based structured extraction.
# LLM extraction is disabled by default. Set HDC_ENABLE_LLM_EXTRACTION=true
# to enable the optional LLM-based structured extraction agent on the
# `structured_extraction` node. Tests must NOT require an API key.
#
# For Anthropic Claude: set HDC_LLM_PROVIDER=anthropic, pick a model from
# your Anthropic account in HDC_LLM_MODEL, and set ANTHROPIC_API_KEY.
# For OpenAI:           set HDC_LLM_PROVIDER=openai, pick a model from
# your OpenAI account in HDC_LLM_MODEL, and set OPENAI_API_KEY.
# Never commit real API keys.
HDC_ENABLE_LLM_EXTRACTION=false
HDC_LLM_PROVIDER=anthropic
HDC_LLM_MODEL=
HDC_LLM_TEMPERATURE=0
HDC_LLM_MAX_TOKENS=4096
HDC_LLM_FALLBACK_TO_RULE_BASED=true

# Stage 6 optional LLM source credibility advisory.
# Disabled by default. The deterministic credibility rubric always runs without
# internet or API keys. When enabled, the LLM sees source metadata and the
# deterministic assessment only; it must not browse, fetch, or create URLs.
HDC_ENABLE_LLM_SOURCE_CREDIBILITY=false
HDC_LLM_SOURCE_CREDIBILITY_MAX_SOURCES=6
HDC_LLM_SOURCE_CREDIBILITY_SOURCE_ID_ALLOWLIST=

# Optional LLM source identity / publisher assessment.
# Disabled by default. When enabled, the LLM sees source metadata and already
# fetched page identity snippets only; it must not browse, search, or fetch.
HDC_ENABLE_LLM_SOURCE_IDENTITY=false
HDC_LLM_SOURCE_IDENTITY_MAX_SOURCES=6
HDC_LLM_SOURCE_IDENTITY_POST_FETCH=true
HDC_LLM_SOURCE_IDENTITY_REQUIRE_LLM=false
HDC_LLM_SOURCE_IDENTITY_ALLOW_DETERMINISTIC_FALLBACK=true

ANTHROPIC_API_KEY=

# Stage 2 optional LLM disease intelligence.
# Disabled by default; curated local profiles are used unless this is true.
HDC_ENABLE_LLM_DISEASE_INTELLIGENCE=false
HDC_DISEASE_INTELLIGENCE_FORCE_LLM=false
HDC_DISEASE_INTELLIGENCE_FALLBACK_TO_CURATED=true

# Step 15 controlled live-source pilot controls.
# HDC_SOURCE_ID_ALLOWLIST optionally restricts content_fetch_and_parse to a
# comma-separated list of source_ids (e.g. src_cdc_reported_cases,src_ecdc_surveillance_updates).
# HDC_LLM_MAX_CHUNKS optionally caps the number of eligible evidence chunks
# sent to the LLM, useful for small live pilots and cost control.
# HDC_LIVE_PILOT_OUTPUT_DIR controls where the pilot exports the final
# data package. Defaults must not change normal workflow behavior.
HDC_SOURCE_ID_ALLOWLIST=
HDC_LLM_MAX_CHUNKS=
HDC_LIVE_PILOT_OUTPUT_DIR=outputs/live_source_llm_pilot
